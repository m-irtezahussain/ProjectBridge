# Copy to .env only when overriding Compose defaults. Never commit real secrets.
POSTGRES_DB=projectbridge
POSTGRES_USER=projectbridge
POSTGRES_PASSWORD=projectbridge-dev-only
DATABASE_URL=postgresql+asyncpg://projectbridge:projectbridge-dev-only@db:5432/projectbridge
APP_ENV=development
APP_JWT_SECRET=replace-with-at-least-32-random-characters
APP_JWT_ISSUER=projectbridge-api
APP_JWT_AUDIENCE=projectbridge-web
APP_JWT_ACCESS_MINUTES=15
APP_REFRESH_SLIDING_DAYS=7
APP_REFRESH_ABSOLUTE_DAYS=30
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://0.0.0.0:3000"]
APP_MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1","127.0.0.1:*"]
APP_MCP_ALLOWED_ORIGINS=["http://localhost:3000"]
APP_WEB_URL=http://localhost:3000
APP_MCP_ISSUER=http://localhost:8000
APP_MCP_RESOURCE=http://localhost:8000/mcp/
APP_MCP_JWT_SECRET=replace-with-a-separate-32-character-mcp-secret
APP_MCP_ACCESS_MINUTES=15
APP_MCP_REFRESH_DAYS=30
APP_MCP_AUTHORIZATION_CODE_MINUTES=5
# Private S3-compatible object storage (MinIO by Silo). Never commit real credentials.
S3_ENDPOINT_URL=https://minio.example.com
S3_ACCESS_KEY_ID=replace-with-minio-access-key
S3_SECRET_ACCESS_KEY=replace-with-minio-secret-key
S3_BUCKET=projectbridge-documents
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PRESIGN_EXPIRY_SECONDS=300
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_IMAGE_PIXELS=40000000
DOCUMENT_MAX_IMAGE_DIMENSION=20000
DOCUMENT_MAX_DECOMPRESSED_BYTES=209715200
OCR_MODEL=PP-OCRv6_small
OCR_LANGUAGE=en
OCR_WORKER_CONCURRENCY=1
OCR_POLL_SECONDS=2
OCR_LEASE_SECONDS=600
OCR_MAX_ATTEMPTS=5
OCR_WORKER_PLATFORM=linux/amd64
NEXT_PUBLIC_API_URL=http://localhost:8000

