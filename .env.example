# Copy to .env only when overriding Compose defaults. Never commit real secrets.
POSTGRES_DB=projectbridge
POSTGRES_USER=projectbridge
POSTGRES_PASSWORD=projectbridge-dev-only
DATABASE_URL=postgresql+asyncpg://projectbridge:projectbridge-dev-only@db:5432/projectbridge
APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1","127.0.0.1:*"]
APP_MCP_ALLOWED_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

